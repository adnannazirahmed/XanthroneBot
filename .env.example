# ─────────────────────────────────────────────────────────────────────────────
# Personal AI Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it contains your private API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Gemini API key — get free at: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_key_here

# Telegram bot token — create a bot via @BotFather on Telegram
TELEGRAM_TOKEN=1234567890:AAHyour_telegram_token_here

# Your Telegram user ID — restricts bot access to only you
# Get it by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_IDS=123456789

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Override the default AI system prompt
# SYSTEM_PROMPT=You are a personal assistant. Be concise and direct.

# Number of conversation turns to remember per session (default: 20)
MAX_HISTORY_TURNS=20

# Port for the local Express server (default: 3000)
PORT=3000
